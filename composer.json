{
  "name": "ruvents/codestyle",
  "license": "MIT",
  "description": "Корпоративный стандарт оформления кода.",
  "type": "phpcodesniffer-standard",
  "keywords": ["cs", "codesniffer"],
  "authors": [
    {
      "name": "Maksim Makhniuk",
      "email": "maksim.makhniuk@ruvents.com",
      "homepage": "https://ruvents.com",
      "role": "Contributor"
    }
  ],
  "autoload": {
    "psr-4": {
      "RUVENTS\\": "RUVENTS"
    }
  },
  "scripts": {
    "test": [
      "RUVENTS\\Scripts::check"
    ]
  },
  "require": {
    "php": "8.4.*",
    "ext-json": "*",
    "squizlabs/php_codesniffer": "3.13.*",
    "slevomat/coding-standard": "8.18.*",
    "fig-r/psr2r-sniffer": "2.2.*",
    "escapestudios/symfony2-coding-standard": "3.11.0"
  },
  "require-dev": {
    "roave/security-advisories": "dev-master",
    "symfony/finder": "7.2.*"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
